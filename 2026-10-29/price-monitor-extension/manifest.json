{
  "manifest_version": 3,
  "name": "价格监控提醒",
  "version": "0.6.6",
  "description": "自动刷新商品页，价格（可配置字段）满足条件时通过企业微信机器人推送提醒",
  "permissions": ["storage", "notifications", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://id5.cbg.163.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "价格监控提醒" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
